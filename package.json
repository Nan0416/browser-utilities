{
  "name": "@ultrasa/browser-utilities",
  "version": "0.1.1",
  "description": "Small TypeScript utilities for browser apps: clipboard, JSON downloads, duration formatting, localStorage preferences, a temporary cache, and stage configuration lookup.",
  "main": "dist/lib/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./download": {
      "types": "./dist/types/download.d.ts",
      "default": "./dist/lib/download.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "download": [
        "dist/types/download.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf ./dist",
    "build": "tsc",
    "test": "npm run test:unit",
    "test:unit": "jest --config jest.config.js",
    "format:fix": "prettier --write \"(src|tests)/**/*.(js|ts|jsx|tsx)\" release.config.js",
    "format:lint": "prettier --check \"(src|tests)/**/*.(js|ts|jsx|tsx)\" release.config.js",
    "release:dryrun": "semantic-release --dry-run"
  },
  "keywords": [
    "browser",
    "clipboard",
    "download",
    "localStorage",
    "cache",
    "utilities"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nan0416/browser-utilities.git"
  },
  "bugs": {
    "url": "https://github.com/Nan0416/browser-utilities/issues"
  },
  "homepage": "https://github.com/Nan0416/browser-utilities#readme",
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "prettier": "^3.2.5",
    "semantic-release": "^25.0.3",
    "ts-jest": "^29.1.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "file-saver": "^2.0.5",
    "json-stable-stringify": "^1.3.0",
    "jszip": "^3.10.1"
  }
}
